# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# General
ENVIRONMENT=development                 # development | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000   # production: https://stocks.example.com (used in LINE buttons)
DOMAIN=stocks.example.com               # production only (Nginx/Let's Encrypt)

# Database / cache (compose builds DATABASE_URL / REDIS_URL from these)
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=stock

# Security
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false                     # true behind HTTPS (set automatically in prod compose)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
ADMIN_EMAIL=admin@example.com           # bootstrap admin, created on first start
ADMIN_PASSWORD=change-me-admin-password
ALLOW_REGISTRATION=false

# Market data providers
PROVIDER_PRIORITY=yahoo,alpha_vantage
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
SEC_USER_AGENT="StockMonitor/1.0 your-email@example.com"   # SEC requires contact info
FRED_API_KEY=
INITIAL_HISTORY_YEARS=10
DEFAULT_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,BRK-B,JPM,V,JNJ,SPY,QQQ,VTI
BENCHMARKS=SPY,QQQ,VTI
MARKET_OVERVIEW_SYMBOLS=^GSPC,^IXIC,^DJI,^RUT,^VIX,SPY,QQQ

# Scheduler (times are America/New_York, Mon-Fri, holiday-aware)
SCHEDULER_ENABLED=true
DAILY_JOB_TIME=17:30
MONTHLY_JOB_TIME=19:00
SEC_FILINGS_JOB_TIME=20:00
NOTIFICATION_DISPATCH_SECONDS=30

# LINE Messaging API (https://developers.line.biz/en/docs/messaging-api/)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=                           # admin recipient (obtained from a verified webhook event)
LINE_WEBHOOK_URL=https://stocks.example.com/api/v1/line/webhook
LINE_ENABLED=true
LINE_DEFAULT_NOTIFICATION_ENABLED=true
LINE_ALERT_COOLDOWN_MINUTES=1440
LINE_MAX_RETRY_ATTEMPTS=3
LINE_DAILY_REPORT_TIME=17:45
LINE_WEEKLY_REPORT_TIME=18:45
